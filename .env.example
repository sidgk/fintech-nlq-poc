# Copy to .env and fill in. Load with: set -a; source .env; set +a
ANTHROPIC_API_KEY=sk-ant-...
SLACK_BOT_TOKEN=xoxb-...      # from "OAuth & Permissions" after installing the app
SLACK_APP_TOKEN=xapp-...     # from "Basic Information" > App-Level Tokens (Socket Mode)

# ── LLM provider ───────────────────────────────────────────────────────
# "gemini" (default) uses Google AI Studio's FREE tier — no credit card.
# "anthropic" uses Claude (needs credits on ANTHROPIC_API_KEY above).
LLM_PROVIDER=gemini
GEMINI_API_KEY=          # free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash

# ── Google Sheets export (optional) ────────────────────────────────────
# Bot replies also create/update a Google Sheet in YOUR Drive. Dormant until
# you finish the one-time OAuth — see workflow/sheets-setup.md.
SHEETS_ENABLED=false

# Defaults are fine for local Docker:
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CLAUDE_MODEL=claude-opus-4-8

# Exec mode: block experimental (uncertified) metrics entirely.
CERTIFIED_ONLY=false
